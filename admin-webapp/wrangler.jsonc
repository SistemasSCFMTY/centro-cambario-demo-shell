// Cloudflare Workers, static assets only (plans/00 Deploy). Build first: npm run build.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "centro-cambario-demo-shell-admin",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/admin-webapp/browser",
    // Deep links (/clientes, /acceso/verificacion) fall back to index.html for the Angular router.
    "not_found_handling": "single-page-application",
  },
}
